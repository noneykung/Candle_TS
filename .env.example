# Copy to .env and fill in. Never commit .env.

# Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# Azure Speech resource (F0). Leave empty to run on gTTS only.
AZURE_SPEECH_KEY=
AZURE_REGION=southeastasia

# Optional: sync slash commands to this one server only (instant, for testing).
# Leave empty in production to sync globally.
DEV_GUILD_ID=

# Optional: 1 = debug logs for voice/DAVE only (no message content, no tokens)
VOICE_DEBUG=

# Optional overrides
# DB_PATH=data/candle.db
# DEFAULT_VOICE=th-TH-PremwadeeNeural
